<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageTags>dotnet;gnss;gps;glonass;galileo;beidou;rinex;rtcm;nmea;ubx;ublox;asterix;asv;gbas;sbf;septentrio;comnav;sino-gnss;javad;greis;</PackageTags>
    <Description>GNSS and aviation protocol codecs for .NET: RINEX OBS/NAV/MET files, RTCM v2/v3, NMEA, UBX, ASTERIX, ASV, GBAS, SBF, ComNav, Javad GREIS, and raw GPS/GLONASS navigation data.</Description>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <DocumentationFile>bin\Release\Asv.Gnss.xml</DocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Asv.Common" Version="$(AsvCommonVersion)" />
    <PackageReference Include="Asv.IO" Version="$(AsvCommonVersion)" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Protocols\Asterix\Messages\AsterixRawMessages.cs" />
  </ItemGroup>
</Project>
